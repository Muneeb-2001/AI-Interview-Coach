"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { createClient, AnamEvent } from "@anam-ai/js-sdk";
import { useRouter } from "next/navigation";

type SpeechRecognitionLike = EventTarget & {
  continuous: boolean;
  interimResults: boolean;
  lang: string;
  start(): void;
  stop(): void;
  abort(): void;
  onstart: (() => void) | null;
  onend: (() => void) | null;
  onerror: ((event: SpeechRecognitionErrorLike) => void) | null;
  onresult: ((event: SpeechRecognitionEventLike) => void) | null;
};

type SpeechRecognitionConstructor = new () => SpeechRecognitionLike;

type SpeechRecognitionErrorLike = Event & {
  error: string;
};

type SpeechRecognitionEventLike = Event & {
  resultIndex: number;
  results: SpeechRecognitionResultLikeListLikeLike;
};

interface SpeechRecognitionResultLikeListLikeLike {
  length: number;
  [index: number]: SpeechRecognitionResultLike;
}

interface SpeechRecognitionResultLike {
  isFinal: boolean;
  [index: number]: SpeechRecognitionAlternativeLike;
}

interface SpeechRecognitionAlternativeLike {
  transcript: string;
  confidence: number;
}

declare global {
  interface Window {
    SpeechRecognition?: SpeechRecognitionConstructor;
    webkitSpeechRecognition?: SpeechRecognitionConstructor;
  }
}
const QUESTIONS = [
  "Please introduce yourself and briefly walk us through your professional background.",
  "What experience do you have that is most relevant to this position?",
  "Can you walk us through your most relevant project or achievement for this role?",
  "What are your strongest skills relevant to this position?",
  "Which tools or platforms have you used most extensively in similar roles?",
  "Describe a challenging work situation, what you did, and the outcome.",
  "Why are you currently looking for a new opportunity?",
  "What type of work arrangement are you looking for, and are you comfortable working the required client time zone?",
  "What are your salary expectations and preferred currency?",
  "If selected, how soon would you be able to start?",
  "Is there anything else relevant to this opportunity that you would like us to know?"
];
const WARNING_LIMIT = 2 * 60; // Red alert starts at 12 minutes (720s)
const HARD_LIMIT = 2 * 60; // Hard auto-submit cutoff at 14 minutes (840s)
const TIME_LIMIT = WARNING_LIMIT; // Re-export for backward-compatibility
const OVERTIME_LIMIT = 0;
const TOTAL_TIME_LIMIT = TIME_LIMIT + OVERTIME_LIMIT;
type Message = {
  id: string;
  speaker: "ai" | "candidate";
  text: string;
  time: string;
};

type InterviewStatus =
  "ready" | "speaking" | "listening" | "processing" | "overtime" | "complete";

export default function VoiceInterviewPage() {
  const handleVideoEnded = () => {
    console.log("YUNA ENDED - SWITCHING TO INTERACTION");

    speakingRef.current = false;
    answerListeningRef.current = true;

    setIsInteractionVideo(true);
    setStatus(isOvertime ? "overtime" : "listening");

    const recognition =
      recognitionRef.current || createRecognition();

    if (recognition) {
      try {
        recognition.start();
      } catch {
        // Recognition may already be running.
      }
    }
  };
  const router = useRouter();

  const [name, setName] = useState("Candidate");
  const [email, setEmail] = useState("");

  const [questionIndex, setQuestionIndex] = useState(0);
  const [isInteractionVideo, setIsInteractionVideo] = useState(false);
  const interactionVideoRef = useRef<HTMLVideoElement | null>(null);
  const yunaVideoRef = useRef<HTMLVideoElement | null>(null);
  const [elapsed, setElapsed] = useState(0);
  useEffect(() => {
    const yunaVideo = yunaVideoRef.current;
    const interactionVideo = interactionVideoRef.current;

    if (!yunaVideo || !interactionVideo) return;

    if (isInteractionVideo) {
      // Stop Yuna completely.
      yunaVideo.pause();

      // Start the silent interaction video.
      interactionVideo.pause();
      interactionVideo.currentTime = 0;
      interactionVideo.muted = true;
      interactionVideo.loop = true;

      interactionVideo.play().catch((error) => {
        console.warn("Interaction playback failed:", error);
      });
    } else {
      // Stop Interaction completely.
      interactionVideo.pause();

      // Start the current Yuna question from the beginning.
      yunaVideo.pause();
      yunaVideo.currentTime = 0;
      yunaVideo.muted = false;
      yunaVideo.loop = false;

      yunaVideo.play().catch((error) => {
        console.warn("Yuna playback failed:", error);
      });
    }
  }, [questionIndex, isInteractionVideo]);

  const [status, setStatus] = useState<InterviewStatus>("ready");
const [messages, setMessages] = useState<Message[]>([]);
  const conversationRef = useRef<Message[]>([]);
  const liveTranscriptRef = useRef("");
  const [liveTranscript, setLiveTranscript] = useState("");
  const [answerTranscript, setAnswerTranscript] = useState("");

  const [cameraOn, setCameraOn] = useState(true);
  const [micOn, setMicOn] = useState(true);

  const [cameraError, setCameraError] = useState("");
  const [mediaReady, setMediaReady] = useState(false);
  const [recording, setRecording] = useState(false);

  const [completed, setCompleted] = useState(false);
  const [endedDueToNoResponse, setEndedDueToNoResponse] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [autoSubmitting, setAutoSubmitting] = useState(false);

  const [countdown, setCountdown] = useState<number | null>(null);

  const [speechSupported, setSpeechSupported] = useState(true);

  const videoRef = useRef<HTMLVideoElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const recorderRef = useRef<MediaRecorder | null>(null);
  const recordedChunksRef = useRef<Blob[]>([]);
  const recognitionRef = useRef<any>(null);

// Keeps speech recognition continuously active during the candidate answer.
// Web Speech API can end automatically after pauses, so onend will restart it.
const answerListeningRef = useRef(false);
const recognitionRunningRef = useRef(false);
const recognitionRestartTimerRef = useRef<number | null>(null);

  const questionIndexRef = useRef(0);
  const answerRef = useRef("");
  const messagesRef = useRef<HTMLDivElement | null>(null);

  const startedRef = useRef(false);
  const autoSubmittedRef = useRef(false);
  const interviewStartTimeRef = useRef<number | null>(null);
  const hardLimitTimerRef = useRef<number | null>(null);
  const submitInterviewRef = useRef<(() => Promise<void>) | null>(null);
  
  const speakingRef = useRef(false);
  // ==================== ANAM LIVE INTERVIEW ====================
  const anamQuestionCountRef = useRef(0);
  const anamMessagesRef = useRef<Record<string, Message>>({});
  const elapsedRef = useRef(0);
  const anamClientRef = useRef<ReturnType<typeof createClient> | null>(null);
  const anamVideoRef = useRef<HTMLVideoElement | null>(null);
  const [totalQuestions, setTotalQuestions] = useState(0);
  const detectedQuestionIdsRef = useRef<Set<string>>(new Set());

  useEffect(() => {
    elapsedRef.current = elapsed;
  }, [elapsed]);

  const handleAnamStream = useCallback(
    (event: {
      id: string;
      content: string;
      role: string;
    }) => {
      if (!event.content?.trim()) return;

      const speaker =
        event.role === "persona"
          ? "ai"
          : event.role === "user"
            ? "candidate"
            : null;

      if (!speaker) return;

      const existing = anamMessagesRef.current[event.id];

      const message: Message = existing
        ? {
            ...existing,
            text: `${existing.text}${event.content}`,
          }
        : {
            id: event.id,
            speaker,
            text: event.content.trim(),
            time: formatTime(elapsedRef.current),
          };

      anamMessagesRef.current[event.id] = message;

      setMessages((current) => {
        const existingIndex = current.findIndex(
          (item) => item.id === event.id,
        );

        if (existingIndex === -1) {
          return [...current, message];
        }

        const updated = [...current];
        updated[existingIndex] = message;
        return updated;
      });

      conversationRef.current = Object.values(anamMessagesRef.current);

      if (
        speaker === "ai" &&
        message.text.includes("?") &&
        !detectedQuestionIdsRef.current.has(event.id)
      ) {
        detectedQuestionIdsRef.current.add(event.id);
        anamQuestionCountRef.current += 1;
        setTotalQuestions(anamQuestionCountRef.current);
      }

      console.log("ANAM TRANSCRIPT STREAM:", message);
    },
    [],
  );

  const handleAnamHistory = useCallback(
    (
      history: Array<{
        id: string;
        content: string;
        role: string;
      }>,
    ) => {
      const mapped: Message[] = history
        .map((message) => {
          const speaker =
            message.role === "persona"
              ? "ai"
              : message.role === "user"
                ? "candidate"
                : null;

          if (!speaker || !message.content?.trim()) {
            return null;
          }

          const existing = anamMessagesRef.current[message.id];

          return {
            id: message.id,
            speaker,
            text: message.content.trim(),
            time: existing?.time ?? formatTime(elapsedRef.current),
          } as Message;
        })
        .filter((message): message is Message => message !== null);

      mapped.forEach((message) => {
        anamMessagesRef.current[message.id] = message;
      });

      conversationRef.current = mapped;
      setMessages(mapped);

      const aiQuestions = mapped.filter(
        (message) =>
          message.speaker === "ai" && message.text.includes("?"),
      );

      anamQuestionCountRef.current = aiQuestions.length;
      setTotalQuestions(aiQuestions.length);

      console.log("ANAM TRANSCRIPT UPDATED:", mapped);
    },
    [],
  );

  useEffect(() => {
    let anamClient: ReturnType<typeof createClient> | null = null;
    let cancelled = false;

    const connectAnam = async () => {
      try {
        const response = await fetch("/api/anam-session", {
          method: "POST",
        });

        if (!response.ok) {
          throw new Error(
            `Anam session request failed: ${response.status}`,
          );
        }

        const data = await response.json();

        if (!data?.sessionToken) {
          throw new Error("Anam session token was not returned.");
        }

        if (cancelled) return;

        anamClient = createClient(data.sessionToken);
        anamClientRef.current = anamClient;

        anamClient.addListener(
          AnamEvent.MESSAGE_STREAM_EVENT_RECEIVED,
          handleAnamStream,
        );

        anamClient.addListener(
          AnamEvent.MESSAGE_HISTORY_UPDATED,
          handleAnamHistory,
        );

        await anamClient.streamToVideoElement("anam-video");

        if (!cancelled) {
          console.log("SUCCESS: Anam live avatar connected.");
        }
      } catch (error) {
        console.error("Anam connection failed:", error);
      }
    };

    void connectAnam();

    return () => {
      cancelled = true;

      try {
        anamClient?.stop();
      } catch {
        // Ignore Anam shutdown errors.
      }

      anamClientRef.current = null;
    };
  }, [handleAnamHistory, handleAnamStream]);

  const formatTime = (seconds: number) => {
    const minutes = Math.floor(seconds / 60);
    const remaining = seconds % 60;

    return `${String(minutes).padStart(2, "0")}:${String(remaining).padStart(
      2,
      "0",
    )}`;
  };

  const addMessage = useCallback(
    (speaker: "ai" | "candidate", text: string) => {
      if (!text.trim()) return;

      const message: Message = {
        id: `${Date.now()}-${Math.random()}`,
        speaker,
        text: text.trim(),
        time: formatTime(elapsed),
      };

      conversationRef.current = [
        ...conversationRef.current,
        message,
      ];

      setMessages((current) => [
        ...current,
        {
          id: `${Date.now()}-${Math.random()}`,
          speaker,
          text: text.trim(),
          time: formatTime(elapsed),
        },
      ]);
    },
    [elapsed],
  );

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);

    const candidateName = params.get("name");
    const candidateEmail = params.get("email");

    if (candidateName) setName(candidateName);
    if (candidateEmail) setEmail(candidateEmail);

    if (conversationRef.current.length === 0) {
      addMessage("ai", QUESTIONS[0]);
    }
  }, [addMessage]);
  /*
   * TIMER
   *
   * Uses real elapsed wall-clock time.
   * The displayed timer continues beyond the 12-minute warning.
   */
  useEffect(() => {
    if (completed) return;

    if (interviewStartTimeRef.current === null) {
      interviewStartTimeRef.current = Date.now();
    }

    const updateElapsed = () => {
      const startTime = interviewStartTimeRef.current;

      if (startTime === null) return;

      setElapsed(
        Math.floor((Date.now() - startTime) / 1000),
      );
    };

    updateElapsed();

    const timer = window.setInterval(updateElapsed, 250);

    return () => window.clearInterval(timer);
  }, [completed]);

  const isOvertime = elapsed >= WARNING_LIMIT;


  /*
   * Camera + microphone
   */
  useEffect(() => {
    let mounted = true;

    const initializeMedia = async () => {
      try {
        if (!navigator.mediaDevices?.getUserMedia) {
          throw new Error(
            "Camera and microphone are not supported by this browser.",
          );
        }

        const stream = await navigator.mediaDevices.getUserMedia({
          video: true,
          audio: true,
        });

        if (!mounted) {
          stream.getTracks().forEach((track) => track.stop());
          return;
        }

        streamRef.current = stream;

        if (videoRef.current) {
          videoRef.current.srcObject = stream;
        }

        setMediaReady(true);

        if ("MediaRecorder" in window) {
          const mimeTypes = [
            "video/webm;codecs=vp9,opus",
            "video/webm;codecs=vp8,opus",
            "video/webm",
          ];

          const supportedType = mimeTypes.find((type) =>
            MediaRecorder.isTypeSupported(type),
          );

          const recorder = supportedType
            ? new MediaRecorder(stream, {
                mimeType: supportedType,
              })
            : new MediaRecorder(stream);

          recorder.ondataavailable = (event) => {
            if (event.data.size > 0) {
              recordedChunksRef.current.push(event.data);
            }
          };

          recorder.onstop = () => {
            console.log('Interview recording finalized:', recordedChunksRef.current.length, 'chunks');
          };

          recorderRef.current = recorder;
          recorder.start(1000);
          setRecording(true);
        }
      } catch (error) {
        console.error("Media initialization error:", error);

        if (mounted) {
          setCameraError(
            error instanceof Error
              ? error.message
              : "Unable to access camera or microphone.",
          );
        }
      }
    };

    initializeMedia();
  

  return () => {
      mounted = false;

      if (recognitionRef.current) {
        recognitionRef.current.abort();
      }

      if (recorderRef.current?.state === "recording") {
        recorderRef.current.stop();
      }

      streamRef.current?.getTracks().forEach((track) => track.stop());

      if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
      }
    };
  }, []);

  /*
   * Speech recognition setup
   *
   * Browser SpeechRecognition is used only for live transcription.
   * MediaRecorder remains responsible for the actual audio/video recording.
   */
  const createRecognition = useCallback(() => {
    if (typeof window === "undefined") return null;

    const Recognition =
      window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!Recognition) {
      console.warn("Speech recognition is not supported by this browser.");
      setSpeechSupported(false);
      return null;
    }

    const recognition = new Recognition();

    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = "en-US";
    (recognition as any).maxAlternatives = 1;

    recognition.onstart = () => {
      recognitionRunningRef.current = true;
      console.log("Speech recognition: started");
      setStatus(isOvertime ? "overtime" : "listening");
    };

    recognition.onresult = (event: any) => {
      let finalText = "";
      let interimText = "";

      for (
        let i = event.resultIndex;
        i < event.results.length;
        i += 1
      ) {
        const result = event.results[i];

        if (result.isFinal) {
          finalText += result[0].transcript + " ";
        } else {
          interimText += result[0].transcript;
        }
      }

      if (interimText.trim()) {
        liveTranscriptRef.current = interimText.trim();
        setLiveTranscript(interimText.trim());
      }

      if (finalText.trim()) {
        const incoming = finalText.trim();
        const previous = answerRef.current.trim();

        if (!previous) {
          answerRef.current = incoming;
        } else if (!previous.endsWith(incoming)) {
          answerRef.current = `${previous} ${incoming}`;
        }

        setAnswerTranscript(answerRef.current);
        console.log("Speech recognition: result", answerRef.current);
      }
    };

    recognition.onerror = (event: any) => {
      console.warn("Speech recognition:", event.error);

      if (
        event.error === "not-allowed" ||
        event.error === "service-not-allowed"
      ) {
        recognitionRunningRef.current = false;
        answerListeningRef.current = false;
        setSpeechSupported(false);
        setStatus("ready");
        return;
      }

      if (event.error !== "aborted" && event.error !== "no-speech") {
        setStatus("ready");
      }
    };

    recognition.onend = () => {
      recognitionRunningRef.current = false;

      console.log("Speech recognition: ended");

      if (
        answerListeningRef.current &&
        !speakingRef.current &&
        !completed &&
        status !== "complete"
      ) {
        if (recognitionRestartTimerRef.current !== null) {
          window.clearTimeout(recognitionRestartTimerRef.current);
        }

        recognitionRestartTimerRef.current = window.setTimeout(() => {
          recognitionRestartTimerRef.current = null;

          if (
            !answerListeningRef.current ||
            speakingRef.current ||
            completed ||
            recognitionRef.current !== recognition
          ) {
            return;
          }

          if (recognitionRunningRef.current) {
            return;
          }

          try {
            console.log("Speech recognition: restarting");
            recognition.start();
          } catch (error) {
            console.warn(
              "Speech recognition restart failed:",
              error,
            );
          }
        }, 300);
      }
    };

    recognitionRef.current = recognition;

    return recognition;
  }, [completed, isOvertime, status]);  /*
   * Automatically start the first interview question
   * once camera/microphone are ready.
   */
  useEffect(() => {
    if (!mediaReady || startedRef.current) return;

    startedRef.current = true;

    const timer = window.setTimeout(() => {
      // Yuna video starts automatically. Listening begins when it ends.
    }, 700);
  

  return () => {
      window.clearTimeout(timer);
    };
  }, [mediaReady]);

  /*
   * Camera toggle
   */
  const toggleCamera = () => {
    const stream = streamRef.current;

    if (!stream) return;

    const videoTracks = stream.getVideoTracks();

    videoTracks.forEach((track) => {
      track.enabled = !cameraOn;
    });

    setCameraOn((value) => !value);
  };

  /*
   * Microphone toggle
   */
  const toggleMic = () => {
    const stream = streamRef.current;

    if (!stream) return;

    const audioTracks = stream.getAudioTracks();

    audioTracks.forEach((track) => {
      track.enabled = !micOn;
    });

    setMicOn((value) => !value);
  };

  /*
   * Finish current answer
   */
  const finishAnswer = () => {
    if (speakingRef.current) return;

    // Stop automatic recognition restart immediately.
    answerListeningRef.current = false;

    const recognition = recognitionRef.current;

    // IMPORTANT:
    // Capture the currently visible interim transcript BEFORE stopping
    // recognition. React state may not update before the button click.
    const currentFinal = answerRef.current.trim();
    const currentInterim = liveTranscript.trim();

    let capturedAnswer = currentFinal;

    if (currentInterim) {
      if (!capturedAnswer) {
        capturedAnswer = currentInterim;
      } else if (
        !capturedAnswer.includes(currentInterim) &&
        !currentInterim.includes(capturedAnswer)
      ) {
        capturedAnswer = `${capturedAnswer} ${currentInterim}`.trim();
      }
    }

    // Save immediately before recognition is stopped.
    answerRef.current = capturedAnswer;

    setStatus("processing");

    if (recognition) {
      try {
        recognition.stop();
      } catch {
        // Ignore stop errors.
      }
    }

    // Wait briefly for Chrome to deliver any final recognition result.
    window.setTimeout(() => {
      const committedAnswer = answerRef.current.trim();
    const pendingLiveAnswer = liveTranscript.trim();

    let finalAnswer = committedAnswer;

    if (pendingLiveAnswer) {
      if (!finalAnswer) {
        finalAnswer = pendingLiveAnswer;
      } else if (
        !finalAnswer.includes(pendingLiveAnswer) &&
        !pendingLiveAnswer.includes(finalAnswer)
      ) {
        finalAnswer = `${finalAnswer} ${pendingLiveAnswer}`.trim();
      }
    }

    answerRef.current = finalAnswer;
    setAnswerTranscript(finalAnswer);

      setLiveTranscript("");
      setAnswerTranscript(finalAnswer);

      if (finalAnswer) {
        addMessage("candidate", finalAnswer);
      }

      window.setTimeout(() => {
        const currentIndex = questionIndexRef.current;

        if (currentIndex < QUESTIONS.length - 1) {
          const nextIndex = currentIndex + 1;

          questionIndexRef.current = nextIndex;
          setQuestionIndex(nextIndex);

          // Add the next AI question to the persistent conversation history.
          addMessage("ai", QUESTIONS[nextIndex]);
          setIsInteractionVideo(false);
          setStatus("speaking");

          setAnswerTranscript("");
          answerRef.current = "";

          window.setTimeout(() => {
            // Waiting for the next Yuna video to finish before listening.
          }, 400);
        } else {
          setCompleted(true);
          setStatus("complete");

          if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
          }

          if (recognitionRef.current) {
            try {
              recognitionRef.current.abort();
            } catch {
              // Ignore shutdown errors.
            }
          }
        }
      }, 150);
    }, 350);
  };

  /*
   * CLICK HERE IF YOU WANT TO END THE INTERVIEW manually
  */  const endInterview = () => {
    const confirmed = window.confirm(
      "Are you sure you want to end the interview? Your recorded responses will be submitted.",
    );

    if (!confirmed) return;

    commitCurrentAnswer();

    if (recognitionRef.current) {
      try {
        recognitionRef.current.abort();
      } catch {
        // Ignore recognition shutdown errors.
      }
    }

    if (recorderRef.current?.state === "recording") {
      try {
        recorderRef.current.stop();
      } catch {
        // Ignore recorder stop errors.
      }
    }

    if ("speechSynthesis" in window) {
      window.speechSynthesis.cancel();
    }

    setCompleted(true);
    setStatus("complete");
  };
  /*
   * Submit completed interview
   */
    const isSubmittingRef = useRef(false);

  const commitCurrentAnswer = () => {
    const finalText = answerRef.current.trim();
    const interimText = liveTranscriptRef.current.trim();

    let committedText = finalText;

    if (interimText) {
      if (!committedText) {
        committedText = interimText;
      } else if (
        !committedText.includes(interimText) &&
        !interimText.includes(committedText)
      ) {
        committedText = `${committedText} ${interimText}`.trim();
      }
    }

    if (!committedText) return;

    const lastMessage = conversationRef.current[conversationRef.current.length - 1];

    if (
      lastMessage?.speaker !== "candidate" ||
      lastMessage.text.trim() !== committedText
    ) {
      addMessage("candidate", committedText);
    }

    answerRef.current = "";
    liveTranscriptRef.current = "";
    setAnswerTranscript("");
    setLiveTranscript("");
  };

  const submitInterview = async () => {
    if (isSubmittingRef.current) {
      console.log("Submission already in progress, skipping duplicate call.");
      return;
    }

    isSubmittingRef.current = true;
    commitCurrentAnswer();
    setSubmitting(true);

    console.log("=== INTERVIEW SUBMISSION STARTED ===");

    try {
      const transcript = conversationRef.current
        .map(
          (message) =>
            `${message.speaker === "ai" ? "AIINTERVIEWER" : "CANDIDATE"}: ${message.text}`,
        )
        .join("\n\n");

      const formData = new FormData();

      formData.append("name", name);
      formData.append("email", email);
      formData.append("transcript", transcript.trim());
      formData.append("questionCount", String(questionIndex + 1));
      formData.append("timeTaken", String(elapsed));
      formData.append("timeExceeded", String(elapsed > 720));
      formData.append(
        "overtimeSeconds",
        String(Math.max(0, elapsed - 720)),
      );

      console.log("Submission metadata:", {
        name,
        email,
        questionCount: questionIndex + 1,
        timeTaken: elapsed,
        timeExceeded: elapsed > 720,
      });

      if (recordedChunksRef.current.length > 0) {
        const recordingBlob = new Blob(recordedChunksRef.current, {
          type: "video/webm",
        });

        const recordingFile = new File(
          [recordingBlob],
          `interview-${Date.now()}.webm`,
          {
            type: "video/webm",
          },
        );

        formData.append("video", recordingFile);

