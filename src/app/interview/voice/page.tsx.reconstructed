                      </p>
                    </div>
                  </div>
                )}

                {cameraError && (
                  <div className="absolute inset-0 flex items-center justify-center bg-[#111827] p-6 text-center">
                    <div>
                      <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-500/10 text-red-400">
                        !
                      </div>
                      <p className="mt-1 text-sm font-semibold text-white">
                        Camera access required
                      </p>
                      <p className="mt-2 text-xs leading-5 text-slate-400">
                        {cameraError}
                      </p>
                      <button
                        type="button"
                        onClick={() => window.location.reload()}
                        className="mt-2 rounded-lg bg-white px-4 py-2 text-xs font-bold text-[#10283d]"
                      >
                        Try again
                      </button>
                    </div>
                  </div>
                )}
              </div>

          </div>

              <div className="mt-3">
                <div className="mt-1">
              <button
                type="button"
                onClick={endInterview}
                className="flex min-h-[64px] w-full items-center justify-center rounded-xl border-2 border-red-700 bg-red-600 px-5 py-3 text-sm font-bold leading-tight text-white shadow-lg shadow-red-500/40 transition hover:bg-red-700 hover:shadow-red-500/60 active:scale-[0.98]"
              >
                CLICK HERE IF YOU WANT TO END THE INTERVIEW
              </button>
            </div>
              </div>
          </aside>
        </div>
      </div>
    </main>
  );
}
















